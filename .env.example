# ── IQ2SAVE configuration ────────────────────────────────────────────────
# Copy to `.env` and edit. Every value below is optional; the defaults shown
# are what the app uses when the variable is absent.

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000

# Interface to bind. Keep 127.0.0.1 so the server is reachable only from
# this device. Set 0.0.0.0 ONLY if you knowingly want other devices on your
# LAN to reach it; that also requires ALLOW_REMOTE=true.
HOST=127.0.0.1
ALLOW_REMOTE=false

# Comma-separated extra origins allowed by CORS. Same-origin requests from
# the bundled UI never need this.
CORS_ORIGINS=

# ── Paths ────────────────────────────────────────────────────────────────
# Where finished files land. If unset, IQ2SAVE prefers
# ~/storage/downloads/ClipMate (visible to Android's file manager, needs
# `termux-setup-storage`) and otherwise falls back to ./downloads
DOWNLOAD_DIR=

# Scratch space for in-progress work. Cleared on a timer.
TEMP_DIR=

# SQLite database file.
DB_PATH=./data/clipmate.db

# ── External binaries ────────────────────────────────────────────────────
# Absolute paths, or bare names to resolve via PATH.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Job execution ────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_MS=1800000
ANALYZE_TIMEOUT_MS=90000

# ── Retention ────────────────────────────────────────────────────────────
# Age at which temp scratch files are deleted. Finished downloads in
# DOWNLOAD_DIR are never auto-deleted.
TEMP_FILE_TTL_MS=3600000
CLEANUP_INTERVAL_MS=600000
# Age at which finished job rows are pruned from the database.
JOB_RECORD_TTL_MS=2592000000

# ── Limits ───────────────────────────────────────────────────────────────
MAX_URL_LENGTH=2048
MAX_BODY_BYTES=16384
# Refuse downloads larger than this. 0 disables the check.
MAX_FILE_BYTES=2147483648
# The UI polls a running download every 900 ms, so this has to stay well
# above ~100. /analyze and /download carry their own stricter limits.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240

# ── Logging ──────────────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info

# ── Branding ─────────────────────────────────────────────────────────────
APP_NAME=IQ2SAVE
APP_TAGLINE=Your Links. Your Media.
